    "./description.md": "./dist/description.md",
    "./illustrations/*": "./dist/illustrations/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/build-packages.js western",
    "prepack": "node ../../scripts/build-packages.js western"
  }
