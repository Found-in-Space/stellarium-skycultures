{
  "name": "@found-in-space/stellarium-skycultures-western",
  "version": "0.2.0",
  "description": "Western Stellarium sky culture assets packaged for Found in Space viewers",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE.txt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Found-in-Space/stellarium-skycultures.git",
    "directory": "packages/stellarium-skycultures-western"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE.txt"
  ],
  "exports": {
    ".": "./src/index.js",
    "./bundled": "./src/bundled.js",
